<mxfile host="Electron" type="device" version="24.7.17"><diagram name="State diagram — synchronization session (SyncEngine)" id="state-diagram-—-synchronization-session-(syncengine)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="20" y="136" width="30" height="30" as="geometry" /></mxCell><mxCell id="n2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="20" y="224" width="30" height="30" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Idle&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="123.78" y="175" width="130" height="40" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Watching&lt;/b&gt;&lt;hr size='1'&gt;do / FolderWatcher.start(dir, onChange)&lt;br&gt;paused while a run is in progress,&lt;br&gt;resumed 3 s after it (cooldown)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="383.81" y="20" width="287.40" height="94" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;PickingFolder&lt;/b&gt;&lt;hr size='1'&gt;do / dialog.showOpenDialog" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="426.71" y="311.00" width="201.60" height="62" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Scanning&lt;/b&gt;&lt;hr size='1'&gt;do / LocalFolderScanner.scan()&lt;br&gt;do / ApiClient.listFiles()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="775.73" y="156" width="228" height="78" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Planning&lt;/b&gt;&lt;hr size='1'&gt;do / computeSyncPlan()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="1120.99" y="164" width="175.20" height="62" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Transferring&lt;/b&gt;&lt;hr size='1'&gt;do / upload | download per SyncAction&lt;br&gt;exit / build SyncReport" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="1433.69" y="156" width="274.20" height="78" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;Completed&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="1834.09" y="126" width="130" height="40" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;Failed&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1"><mxGeometry x="1834.09" y="224" width="130" height="40" as="geometry" /></mxCell><mxCell id="n11" value="A failed upload or download is caught per action:&lt;br&gt;it is counted in SyncReport.failed / errors and the run&lt;br&gt;still ends in Completed.  Failed is reached only when the&lt;br&gt;whole run throws (no folder, IPC error) — the report is&lt;br&gt;then failedSyncReport(message)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;spacingRight=10;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="2000.09" y="191" width="330" height="106" as="geometry" /></mxCell><mxCell id="n12" value="Notation: rounded rectangle = state (do / … = activity while in the state, exit / … = action on leaving);&lt;br&gt;filled circle = initial pseudo-state; bull's-eye = final state; arrow = transition «event [guard] / action».&lt;br&gt;Colours: purple = synchronization, blue = folder picker dialog, green = completion, red = aborted run.&lt;br&gt;Watching (FolderWatcher, UC14a) exists in the desktop client only; the web client always returns to Idle." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=6;spacingTop=4;fontSize=10;strokeColor=#8C97A3;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="20" y="463.00" width="680" height="76" as="geometry" /></mxCell><mxCell id="e13" value="" style="endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;" parent="1" edge="1" source="n1" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="app quit" style="endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;" parent="1" edge="1" source="n3" target="n2"><mxGeometry relative="1" as="geometry" x="-0.08" y="0"><mxPoint x="-2.74" y="-9.45" as="offset" /></mxGeometry></mxCell><mxCell id="e15" value="sync.watch(true)&lt;br&gt;/ FolderWatcher.start()" style="endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;" parent="1" edge="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" x="0.28" y="0"><mxPoint x="-7.74" y="-23.28" as="offset" /><Array as="points"><mxPoint x="273.80" y="151" /></Array></mxGeometry></mxCell><mxCell id="e16" value="synchronize()&lt;br&gt;[folder bound]" style="endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;" parent="1" edge="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry" x="0.05" y="0"><mxPoint x="0" y="-11.25" as="offset" /></mxGeometry></mxCell><mxCell id="e17" value="synchronize()&lt;br&gt;[no folder]" style="endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;" parent="1" edge="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry" x="-0.03" y="0"><mxPoint x="-18.60" y="-9.23" as="offset" /><Array as="points"><mxPoint x="273.80" y="261.50" /></Array></mxGeometry></mxCell><mxCell id="e18" value="sync.watch(false)&lt;br&gt;/ FolderWatcher.stop()" style="edgeStyle=none;endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;curved=1;" parent="1" edge="1" source="n4" target="n3"><mxGeometry relative="1" as="geometry" x="-0.35" y="0"><Array as="points"><mxPoint x="370.87" y="164.68" /></Array></mxGeometry></mxCell><mxCell id="e19" value="cancelled" style="edgeStyle=none;endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;curved=1;" parent="1" edge="1" source="n5" target="n3"><mxGeometry relative="1" as="geometry" x="-0.35" y="0"><Array as="points"><mxPoint x="372.48" y="235.48" /></Array></mxGeometry></mxCell><mxCell id="e20" value="fs event&lt;br&gt;(debounced 2 s)" style="endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;" parent="1" edge="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry" x="-0.05" y="0"><mxPoint x="6.42" y="-18.08" as="offset" /></mxGeometry></mxCell><mxCell id="e21" value="folder chosen&lt;br&gt;/ save path" style="endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;" parent="1" edge="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" x="0.16" y="0"><mxPoint x="-7.14" y="-20.15" as="offset" /><Array as="points"><mxPoint x="755.72" y="261.50" /></Array></mxGeometry></mxCell><mxCell id="e22" value="local + remote lists" style="endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;" parent="1" edge="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" x="-0.00" y="0"><mxPoint x="0" y="-5.62" as="offset" /></mxGeometry></mxCell><mxCell id="e23" value="plan ready&lt;br&gt;(runSyncPlan; an empty&lt;br&gt;plan runs too)" style="endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;" parent="1" edge="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" x="0.00" y="0"><mxPoint x="0" y="-16.87" as="offset" /></mxGeometry></mxCell><mxCell id="e24" value="all actions done" style="endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;" parent="1" edge="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry" x="0.03" y="0"><mxPoint x="-1.70" y="-11.31" as="offset" /></mxGeometry></mxCell><mxCell id="e25" value="the whole run throws&lt;br&gt;/ failedSyncReport" style="endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;" parent="1" edge="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry" x="-0.04" y="0"><mxPoint x="2.45" y="-16.30" as="offset" /></mxGeometry></mxCell><mxCell id="e26" value="report shown" style="edgeStyle=none;endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;rounded=1;arcSize=20;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="n9" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2004.09" y="146" /><mxPoint x="2004.09" y="-80" /><mxPoint x="188.78" y="-80" /></Array></mxGeometry></mxCell><mxCell id="e27" value="report shown" style="edgeStyle=none;endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor=#ffffff;rounded=1;arcSize=20;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="n10" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1899.09" y="423.00" /><mxPoint x="188.78" y="423.00" /></Array></mxGeometry></mxCell><mxCell id="e28" value="[watching]" style="edgeStyle=none;endArrow=open;endSize=12;endFill=0;html=1;labelBackgroundColor