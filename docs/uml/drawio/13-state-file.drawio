ze=11;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="597.59" y="486" width="130" height="40" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;ModifiedLocally&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="926.15" y="126" width="130" height="40" as="geometry" /></mxCell><mxCell id="n9" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="976.15" y="317" width="30" height="30" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;ModifiedRemotely&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="923.35" y="486" width="135.60" height="40" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;Conflict&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1"><mxGeometry x="1214.19" y="350" width="130" height="40" as="geometry" /></mxCell><mxCell id="n12" value="deleted on server → LocalOnly:&lt;br&gt;deletions never propagate;&lt;br&gt;next sync re-uploads the file" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;spacingRight=10;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="295.31" y="20" width="200" height="70" as="geometry" /></mxCell><mxCell id="n13" value="deleted locally → RemoteOnly:&lt;br&gt;next sync re-downloads the file" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;spacingRight=10;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="292.31" y="562" width="206" height="52" as="geometry" /></mxCell><mxCell id="n14" value="UC14b: both sides changed —&lt;br&gt;newest version wins&lt;br&gt;(local mtime vs updatedAt)" style="shape=note;whiteSp